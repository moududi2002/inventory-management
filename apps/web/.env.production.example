# ============================================
# PRODUCTION — Frontend (apps/web/.env.local)
# ============================================

# Points to the API base URL (behind Nginx on the same domain)
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Base URL for socket.io + static uploads (no /api suffix)
NEXT_PUBLIC_SOCKET_URL=https://your-domain.com

# App display name
NEXT_PUBLIC_APP_NAME=Your Shop
