# ============================================
# PRODUCTION — Backend (apps/api/.env)
# ============================================

NODE_ENV=production
PORT=4000
API_PREFIX=api

# MongoDB (use a dedicated user; not root)
MONGODB_URI=mongodb://inventory_user:STRONG_PASSWORD@127.0.0.1:27017/inventory?authSource=inventory

# JWT — generate a fresh secret for production:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# CORS — your real domain(s), comma-separated
CORS_ORIGIN=https://your-domain.com

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
PUBLIC_URL=https://your-domain.com

# Seed admin (used by `pnpm seed:admin` only; keep secret)
ADMIN_NAME=Owner
ADMIN_EMAIL=owner@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_NOW

# Gmail SMTP — use an App Password (NOT your real Gmail password)
# Enable 2FA in Google Account → App passwords → generate
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-shop-email@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM="Your Shop <your-shop-email@gmail.com>"

# Scheduler — daily at 9:00 server time
LOW_STOCK_CRON=0 9 * * *
