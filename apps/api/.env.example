# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=4000
API_PREFIX=api

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/inventory

# ============================================
# AUTH
# ============================================
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# UPLOADS
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
PUBLIC_URL=http://localhost:4000

# ============================================
# ADMIN SEED (used by `pnpm seed:admin` only)
# ============================================
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# ============================================
# GMAIL SMTP (low stock alerts)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM="Inventory System <your-email@gmail.com>"

# ============================================
# SCHEDULER (daily low stock summary)
# ============================================
LOW_STOCK_CRON=0 9 * * *
